    if(target.dataset.hotspot!==undefined){state.hotspot=Number(target.dataset.hotspot);renderVisual();document.querySelector(`[data-hotspot="${state.hotspot}"]`).focus();return;}
    if(target.dataset.sequence!==undefined){setSequence(Number(target.dataset.sequence));return;}
    if(target.id==='play-sequence'){toggleSequence();return;}
    const action=target.dataset.action;if(!action)return;
    if(action==='close')$('modal').close();else if(action==='print')window.print();else if(action==='download')downloadSummary();else if(action==='confirm-reset'){state.completed.clear();state.answers={};$('modal').close();go(0);}else openModal(action);
  });
  $('back').addEventListener('click',()=>go(state.index-1));$('next').addEventListener('click',next);$('listen').addEventListener('click',speak);
  $('font-down').addEventListener('click',()=>resizeText(-.125));$('font-up').addEventListener('click',()=>resizeText(.125));$('font-down').disabled=true;
  $('caregiver-toggle').addEventListener('change',e=>{state.caregiver=e.target.checked;stopAudio();renderRight();});
  $('language').addEventListener('change',e=>{const lang=e.target.value;if(!TRANSLATIONS[lang]){e.target.value=state.language;toast(t('languageUnavailable'));return;}stopAudio();state.language=lang;document.documentElement.lang=lang;render();});
  $('close-modal').addEventListener('click',()=>$('modal').close());
  $('modal').addEventListener('click',e=>{if(e.target===$('modal')){const r=$('modal').getBoundingClientRect();if(e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom)$('modal').close();}});
  window.addEventListener('pagehide',()=>{stopAudio();stopSequence();});
  document.addEventListener('visibilitychange',()=>{if(document.hidden){stopAudio();if(state.playing){stopSequence();renderVisual();}}});
  if('speechSynthesis' in window)window.speechSynthesis.getVoices();
  render();
  </script></body>
</html>
